# --- n8n core ---
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-please
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-too
# Set to "true" when serving n8n over HTTPS.
N8N_SECURE_COOKIE=false
# The workflow reads its tunables from $env inside expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- app config ---
SCHEDULE_CRON=0 9 * * *
CRAWL_DELAY=3
LLM_MODEL=laguna-xs-2-1:free
# OpenAI-compatible endpoint (kenari.id). Ganti kalau pakai OpenAI asli:
#   LLM_BASE_URL=https://api.openai.com/v1  +  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://kenari.id/v1
OPENAI_API_KEY=
AUTO_PUBLISH=false
PUBLISHER_MODE=simulate

# --- notifications ---
# Generic webhook (Discord/Telegram/Slack incoming webhook). Leave empty to disable.
ALERT_CHANNEL=
# Reviewer notification channel (email or Telegram). Leave empty to disable.
REVIEWER_NOTIFY=
