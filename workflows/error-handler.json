{
  "id": "DHIVZYteY2q3wEtS",
  "name": "PlacidWay - Error Handler",
  "description": null,
  "nodes": [
    {
      "id": "b619e9d2-fac2-5b9e-8f02-eed3f94f42b2",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {},
      "notes": "Catches ANY unhandled error in the main workflow",
      "notesInFlow": true,
      "color": "#ff4d4f"
    },
    {
      "id": "b4463ae2-8768-5789-bfb7-c2b8e2b33dcb",
      "name": "Build error record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// n8n's Error Trigger outputs { execution: { error, url, mode, ... }, workflow: {...} }\nconst ex = $json.execution || {};\nconst err = ex.error || {};\nconst failedNode = err.node || {};\nconst message = (typeof err === 'string' ? err : (err.message || 'Unknown error'));\nreturn [{\n  json: {\n    run_id: 'run_' + new Date().getTime(),\n    timestamp: new Date().toISOString(),\n    status: 'failed',\n    selected_url: '',\n    content_type: '',\n    post_text: '',\n    guardrail_result: 'n/a',\n    publisher_mode: 'n/a',\n    post_id: '',\n    error: message,\n    error_type: err.type || err.name || 'unknown',\n    workflow_id: $json.workflow ? $json.workflow.id : '',\n    execution_id: ex.id || '',\n    execution_url: ex.url || '',\n    failed_node: failedNode.name || '',\n  },\n}];\n"
      },
      "notes": "Normalize the error payload",
      "notesInFlow": true,
      "color": "#ff4d4f"
    },
    {
      "id": "052e2fda-ec9a-5a43-a690-90165fbc96b5",
      "name": "Log failure",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "mode": "name",
          "value": "run_logs"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json.run_id }}",
            "timestamp": "={{ $json.timestamp }}",
            "selected_url": "",
            "content_type": "",
            "post_text": "",
            "guardrail_result": "n/a",
            "publisher_mode": "n/a",
            "post_id": "",
            "status": "failed",
            "error": "={{ $json.error }}"
          }
        }
      },
      "notes": "Persist the failure - never silent",
      "notesInFlow": true,
      "color": "#ff4d4f"
    },
    {
      "id": "5ff36c49-30b4-59ff-9cec-669f39d768ad",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// This workflow has no Config node, so read the env var directly.\nconst channel = $env.ALERT_CHANNEL || '';\nconst text = '[PlacidWay Bot] Workflow FAILED: ' + ($json.error || 'unknown');\nreturn [{ json: { channel: channel, message: text, text: text, severity: 'error', kind: 'workflow_error' } }];\n"
      },
      "notes": "Alert payload",
      "notesInFlow": true,
      "color": "#ff4d4f"
    },
    {
      "id": "4a13a8d0-d1ef-5588-99bb-ea1a42bfcd2c",
      "name": "Send alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.channel }}",
        "sendBody": true,
        "contentType": "raw",
        "body": "={{ JSON.stringify({text: $json.text, content: $json.text, message: $json.message}) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "notes": "ALERT_CHANNEL webhook",
      "notesInFlow": true,
      "color": "#ff4d4f",
      "onError": "continueRegularOutput"
    },
    {
      "id": "09202d11-df0d-5690-8722-61e9d27b5d67",
      "name": "Stop",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "errorMessage": "={{ $('Build error record').first().json.error }}",
        "errorType": "errorMessage"
      },
      "notes": "Surface the failure in the n8n UI",
      "notesInFlow": true,
      "color": "#ff4d4f"
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build error record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build error record": {
      "main": [
        [
          {
            "node": "Log failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log failure": {
      "main": [
        [
          {
            "node": "Build alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build alert": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send alert": {
      "main": [
        [
          {
            "node": "Stop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Jakarta"
  },
